# Copy to .env and adjust. Only MONGODB_URI is required.

# --- Required -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/sales_dashboard

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS and Socket.io.
CLIENT_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops in front of the API (usually 1 on Render/Railway/Nginx).
# Needed so the rate limiter sees real client addresses. Leave unset when not behind a proxy.
# TRUST_PROXY=1
RATE_LIMIT_MAX=1500
UPLOAD_RATE_LIMIT_MAX=30

# --- Redis / BullMQ -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Run the worker inside the API process (default) or set to false and use `npm run worker`
# (recommended for files with 100,000+ rows).
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=1
# How long POST /uploads waits for Redis before answering 503.
ENQUEUE_TIMEOUT_MS=5000
# Hosted Redis (Redis Cloud, Upstash, Railway...) over a home/office network: send a TCP
# keep-alive probe this often (ms) so idle connections are not silently dropped, which is
# what shows up as "connect ETIMEDOUT". Use a rediss:// URL if your provider requires TLS.
REDIS_KEEPALIVE_MS=10000
# How long (ms) a running upload may lose contact with Redis before BullMQ re-runs it.
WORKER_LOCK_MS=120000
# true = send upload events only to browsers that joined the batch room (see upload.queue.js).
SOCKET_ROOMS=false

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=50
# UPLOAD_DIR=/var/tmp/sales-uploads
# Skipped-row messages stored per upload (the true count is always kept).
MAX_ERROR_LOGS=1000
# How to read a/b/YYYY dates when a file has no day > 12 or month > 12 to prove the order.
# Files that do prove it (like US-style 5/26/2025) are detected automatically. dmy | mdy
DEFAULT_DATE_ORDER=dmy
# An upload stuck in queued/processing longer than this may be deleted anyway.
STALE_UPLOAD_MINUTES=60

# --- MongoDB --------------------------------------------------------------
MONGODB_MAX_POOL_SIZE=20
# Set to true for ONE start-up on an existing database: creates missing indexes and
# drops the old single-field SalesRecord indexes the new schema no longer declares.
SYNC_INDEXES=false

# --- Analytics response cache ---------------------------------------------
# Seconds a finished batch's analytics responses are reused. 0 disables caching.
CACHE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=500
